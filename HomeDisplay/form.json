{
    "elements": [
        {
            "type": "Label",
            "caption": "Diese Instanz ist eine Anzeige. Dienst und Dienstadresse werden zentral in der Instanz „Hausanzeige Verwaltung“ eingestellt."
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "Label",
            "caption": "Kopplung: Den Code von der Anzeige eintragen und übernehmen. Die Anzeige erhält den Schlüssel beim nächsten Abruf."
        },
        {
            "type": "ValidationTextBox",
            "name": "ClaimCode",
            "caption": "Kopplungscode von der Anzeige"
        },
        {
            "type": "Select",
            "name": "LayoutId",
            "caption": "Seitenlayout",
            "options": []
        },
        {
            "type": "Select",
            "name": "ConfigId",
            "caption": "Konfiguration",
            "options": []
        },
        {
            "type": "Label",
            "caption": "Die Liste gilt, wenn keine veröffentlichte Ansicht mit Kacheln gewählt ist. Die Position sortiert die Zeilen. Eine freie Platzierung gibt es nicht."
        },
        {
            "type": "List",
            "name": "FallbackTiles",
            "caption": "Kacheln",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "sort": {"column": "Position", "direction": "ascending"},
            "columns": [
                {"name": "Position", "caption": "Position", "width": "80px", "add": 1, "edit": {"type": "NumberSpinner", "minimum": 1, "maximum": 99}},
                {"name": "Page", "caption": "Seite", "width": "160px", "add": "start", "edit": {"type": "Select", "options": [
                    {"caption": "Start", "value": "start"},
                    {"caption": "Energie", "value": "energie"},
                    {"caption": "Klima", "value": "klima"},
                    {"caption": "Licht", "value": "licht"},
                    {"caption": "Rollladen", "value": "rollladen"},
                    {"caption": "Pool und Whirlpool", "value": "pool"},
                    {"caption": "Garten", "value": "garten"},
                    {"caption": "System", "value": "system"}
                ]}},
                {"name": "Col", "caption": "Spalte", "width": "70px", "add": 0, "edit": {"type": "NumberSpinner", "minimum": 0, "maximum": 3}},
                {"name": "Row", "caption": "Zeile", "width": "70px", "add": 0, "edit": {"type": "NumberSpinner", "minimum": 0, "maximum": 11}},
                {"name": "Icon", "caption": "Symbol", "width": "120px", "add": "energy", "edit": {"type": "Select", "options": [
                    {"caption": "Energie", "value": "energy"},
                    {"caption": "Temperatur", "value": "temperature"},
                    {"caption": "Licht", "value": "light"},
                    {"caption": "Rollladen", "value": "shutter"},
                    {"caption": "Pumpe", "value": "pump"},
                    {"caption": "Ventil", "value": "valve"},
                    {"caption": "Alarm", "value": "alarm"}
                ]}},
                {"name": "Title", "caption": "Titel", "width": "160px", "add": "Kachel", "edit": {"type": "ValidationTextBox"}},
                {"name": "VariableID", "caption": "Variable", "width": "220px", "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "Unit", "caption": "Einheit", "width": "70px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Decimals", "caption": "Nachkommastellen", "width": "110px", "add": 0, "edit": {"type": "NumberSpinner", "minimum": 0, "maximum": 3}},
                {"name": "Action", "caption": "Schaltbar", "width": "80px", "add": false, "edit": {"type": "CheckBox"}},
                {"name": "Confirm", "caption": "Bestätigung", "width": "100px", "add": false, "edit": {"type": "CheckBox"}},
                {"name": "ActionKind", "caption": "Aktionsart", "width": "110px", "add": "switch", "edit": {"type": "Select", "options": [
                    {"caption": "Schalten", "value": "switch"},
                    {"caption": "Dimmen", "value": "dim"},
                    {"caption": "Position", "value": "position"}
                ]}},
                {"name": "Control", "caption": "Bedienung", "width": "140px", "add": "switch", "edit": {"type": "Select", "options": [
                    {"caption": "Schalter", "value": "switch"},
                    {"caption": "Dimmschalter", "value": "dimSwitch"},
                    {"caption": "Dimmbalken", "value": "slider"},
                    {"caption": "Kombischalter", "value": "combo"}
                ]}}
            ]
        },
        {
            "type": "Select",
            "name": "IdleMode",
            "caption": "Ruheanzeige",
            "options": [
                {"caption": "Uhrseite", "value": 0},
                {"caption": "Letzte Seite", "value": 1},
                {"caption": "Bildschirm aus", "value": 2}
            ]
        },
        {
            "type": "CheckBox",
            "name": "NightDim",
            "caption": "Nachts dimmen"
        },
        {
            "type": "NumberSpinner",
            "name": "DayBrightness",
            "caption": "Helligkeit Tag (0–100)",
            "minimum": 0,
            "maximum": 100
        },
        {
            "type": "NumberSpinner",
            "name": "NightBrightness",
            "caption": "Helligkeit Nacht (0–100)",
            "minimum": 0,
            "maximum": 100
        },
        {
            "type": "NumberSpinner",
            "name": "NightFrom",
            "caption": "Nacht ab Stunde",
            "minimum": 0,
            "maximum": 23
        },
        {
            "type": "NumberSpinner",
            "name": "NightTo",
            "caption": "Nacht bis Stunde (exkl.)",
            "minimum": 0,
            "maximum": 23
        },
        {
            "type": "NumberSpinner",
            "name": "StateIntervalSec",
            "caption": "Wertabruf (Sekunden)",
            "minimum": 2,
            "maximum": 60
        },
        {
            "type": "NumberSpinner",
            "name": "IdleStateIntervalSec",
            "caption": "Wertabruf auf der Uhrseite (Sekunden)",
            "minimum": 5,
            "maximum": 300
        },
        {
            "type": "NumberSpinner",
            "name": "MaintenanceFrom",
            "caption": "Programmaktualisierung ab Stunde",
            "minimum": 0,
            "maximum": 23
        },
        {
            "type": "NumberSpinner",
            "name": "MaintenanceTo",
            "caption": "Programmaktualisierung bis Stunde (exkl.)",
            "minimum": 0,
            "maximum": 23
        }
    ],
    "actions": [
        {
            "type": "Button",
            "label": "Kopplungscode übernehmen",
            "onClick": "HDISP_Pair($_IPS['TARGET']);"
        },
        {
            "type": "Button",
            "label": "Kopplung lösen",
            "onClick": "HDISP_Unpair($_IPS['TARGET']);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "label": "Verbindung testen",
                    "onClick": "echo HDISP_TestConnection($_IPS['TARGET']);"
                },
                {
                    "type": "Button",
                    "label": "Vorschau senden",
                    "onClick": "echo HDISP_SendPreview($_IPS['TARGET']);"
                },
                {
                    "type": "Button",
                    "label": "Vollständig synchronisieren",
                    "onClick": "echo HDISP_Resynchronize($_IPS['TARGET']);"
                },
                {
                    "type": "Button",
                    "label": "Testbild an",
                    "onClick": "echo HDISP_ShowTestPattern($_IPS['TARGET'], true);"
                },
                {
                    "type": "Button",
                    "label": "Testbild aus",
                    "onClick": "echo HDISP_ShowTestPattern($_IPS['TARGET'], false);"
                },
                {
                    "type": "Button",
                    "label": "Anzeige neu starten",
                    "confirm": "Die Anzeige startet beim nächsten Abruf neu. Fortfahren?",
                    "onClick": "echo HDISP_RestartPanel($_IPS['TARGET']);"
                }
            ]
        },
        {
            "type": "Button",
            "label": "Vorlage Energie",
            "onClick": "HDISP_ApplyPreset($_IPS['TARGET'], 'energy');"
        },
        {
            "type": "Button",
            "label": "Vorlage Whirlpool",
            "onClick": "HDISP_ApplyPreset($_IPS['TARGET'], 'whirl');"
        },
        {
            "type": "Button",
            "label": "Vorlage Pool",
            "onClick": "HDISP_ApplyPreset($_IPS['TARGET'], 'pool');"
        },
        {
            "type": "Button",
            "label": "Vorlage Wasserwerte",
            "onClick": "HDISP_ApplyPreset($_IPS['TARGET'], 'tuya');"
        },
        {
            "type": "Button",
            "label": "Vorlage Garten",
            "onClick": "HDISP_ApplyPreset($_IPS['TARGET'], 'gardena');"
        },
        {
            "type": "Button",
            "label": "Kachelliste veröffentlichen",
            "onClick": "HDISP_PublishFallback($_IPS['TARGET']);"
        }
    ],
    "status": [
        {"code": 102, "icon": "active", "caption": "Hausanzeige aktiv"},
        {"code": 104, "icon": "inactive", "caption": "Hausanzeige inaktiv"},
        {"code": 203, "icon": "error", "caption": "Kein Dienst: Instanz „Hausanzeige Verwaltung“ anlegen"}
    ]
}
