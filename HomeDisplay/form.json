{
    "elements": [
        {
            "type": "Label",
            "caption": "Diese Instanz ist eine Anzeige. Dienst und Dienstadresse werden zentral in der Instanz „Hausanzeige Verwaltung“ eingestellt."
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "Label",
            "caption": "Kopplung: Code vom Display ablesen, hier eintragen, Instanz übernehmen, dann „Kopplungscode übernehmen“. Das Display fragt alle 3 s den Dienst ab – WLAN und Hook-URL müssen am Gerät stimmen (https://IP:3777/hook/homedisplay). Nach Neustart des Displays ist der Code neu."
        },
        {
            "type": "ValidationTextBox",
            "name": "ClaimCode",
            "caption": "Kopplungscode von der Anzeige"
        },
        {
            "type": "Select",
            "name": "LayoutId",
            "caption": "Seitenlayout",
            "options": []
        },
        {
            "type": "Select",
            "name": "DisplayProfile",
            "caption": "Display-Profil (Hardware)",
            "options": [
                {"caption": "Waveshare 5B (1024×600)", "value": "waveshare-5b-1024x600"}
            ]
        },
        {
            "type": "Label",
            "name": "EpdServerFrameHint",
            "caption": "E-Ink FireBeetle: Auf dem Display sind partielle Updates standardmäßig an (nur geänderte Kacheln). Optional rendert IPS die ganze Seite; das Gerät lädt das Bitmap und aktualisiert nur geänderte Bereiche — einheitlichere Grafik, weniger Rechenlast auf dem ESP. Voraussetzung: PHP-Erweiterung GD."
        },
        {
            "type": "CheckBox",
            "name": "EpdServerFrame",
            "caption": "E-Ink: Seitenbild auf dem Server rendern"
        },
        {
            "type": "Label",
            "caption": "Ausschalten und Ruheanzeige stehen in der Ansicht. Abruf und Programmaktualisierung gelten nur für diese Anzeige."
        },
        {
            "type": "NumberSpinner",
            "name": "StateIntervalSec",
            "caption": "Wertabruf (Sekunden)",
            "minimum": 2,
            "maximum": 60
        },
        {
            "type": "NumberSpinner",
            "name": "IdleStateIntervalSec",
            "caption": "Wertabruf auf der Uhrseite (Sekunden)",
            "minimum": 5,
            "maximum": 300
        },
        {
            "type": "NumberSpinner",
            "name": "MaintenanceFrom",
            "caption": "Programmaktualisierung ab Stunde",
            "minimum": 0,
            "maximum": 23
        },
        {
            "type": "NumberSpinner",
            "name": "MaintenanceTo",
            "caption": "Programmaktualisierung bis Stunde (exkl.)",
            "minimum": 0,
            "maximum": 23
        },
        {
            "type": "CheckBox",
            "name": "FirmwareAutoUpdate",
            "caption": "Programm automatisch aktualisieren (im Wartungsfenster)"
        },
        {
            "type": "Label",
            "name": "FirmwareInfo",
            "caption": "Programm"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Kopplungscode übernehmen",
            "onClick": "HDISP_Pair($id);"
        },
        {
            "type": "Button",
            "caption": "Kopplung lösen",
            "onClick": "HDISP_Unpair($id);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Verbindung testen",
                    "onClick": "echo HDISP_TestConnection($id);"
                },
                {
                    "type": "Button",
                    "caption": "Vorschau senden",
                    "onClick": "echo HDISP_SendPreview($id);"
                },
                {
                    "type": "Button",
                    "caption": "Vollständig synchronisieren",
                    "onClick": "echo HDISP_Resynchronize($id);"
                },
                {
                    "type": "Button",
                    "caption": "Testbild an",
                    "onClick": "echo HDISP_ShowTestPattern($id, true);"
                },
                {
                    "type": "Button",
                    "caption": "Testbild aus",
                    "onClick": "echo HDISP_ShowTestPattern($id, false);"
                },
                {
                    "type": "Button",
                    "caption": "Anzeige neu starten",
                    "confirm": "Die Anzeige startet beim nächsten Abruf neu. Fortfahren?",
                    "onClick": "echo HDISP_RestartPanel($id);"
                },
                {
                    "type": "Button",
                    "caption": "Programm jetzt aktualisieren",
                    "confirm": "Die Anzeige lädt das bereitgestellte Programm beim nächsten Abruf, auch außerhalb des Wartungsfensters, und startet neu. Fortfahren?",
                    "onClick": "echo HDISP_UpdateFirmware($id);"
                }
            ]
        }
    ],
    "status": [
        {"code": 102, "icon": "active", "caption": "Hausanzeige aktiv"},
        {"code": 104, "icon": "inactive", "caption": "Hausanzeige inaktiv"},
        {"code": 203, "icon": "error", "caption": "Kein Dienst: Instanz „Hausanzeige Verwaltung“ anlegen"}
    ]
}
