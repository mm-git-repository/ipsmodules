{
    "elements": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Image",
                    "caption": "Vorschau",
                    "image": "data:image/png;base64,",
                    "width": "192px",
                    "center": true
                },
                {
                    "type": "Image",
                    "caption": "Vorschau Grafikmodus",
                    "image": "data:image/png;base64,",
                    "width": "192px",
                    "center": true
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "name": "GraphicModeTextButton",
                    "caption": "Text",
                    "onClick": "SMAPX_SetGraphicModeFromForm($id, false);"
                },
                {
                    "type": "Button",
                    "name": "GraphicModeGraphicButton",
                    "caption": "Grafik",
                    "onClick": "SMAPX_SetGraphicModeFromForm($id, true);"
                }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "PixooIp",
            "caption": "Pixoo IP-Adresse"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateIntervalSeconds",
            "caption": "Aktualisierung Werte + Pixoo-Display (Sekunden, mindestens 1; ein gemeinsamer Zyklus pro Intervall)",
            "digits": 0,
            "minimum": 1
        },
        {
            "type": "CheckBox",
            "name": "PixooHourlyReinit",
            "caption": "Regelmäßiger Neuaufbau der Anzeige (wie Button „Display neu initialisieren“: eigener Kanal, Hintergrundbild und Texte)"
        },
        {
            "type": "NumberSpinner",
            "name": "PixooDisplayRefreshMinutes",
            "caption": "Intervall für den Neuaufbau (Minuten, mindestens 15)",
            "digits": 0,
            "minimum": 15
        },
        {
            "type": "ExpansionPanel",
            "caption": "Pixoo: Helligkeit (Tag & Nacht)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Taghelligkeit gilt immer; Nachthelligkeit optional nach Uhrzeit des IP-Symcon-Servers (Felder unten)."
                },
                {
                    "type": "NumberSpinner",
                    "name": "DefaultBrightness",
                    "caption": "Helligkeit Tag (0–100)",
                    "digits": 0
                },
                {
                    "type": "Label",
                    "caption": "Zeitbezug: Uhrzeit des IP-Symcon-Servers. „Nacht“ von Stunde (inkl.) bis Stunde (exkl.); über Mitternacht z. B. 22 → 6."
                },
                {
                    "type": "CheckBox",
                    "name": "PixooNightBrightnessUse",
                    "caption": "Nachthelligkeit verwenden"
                },
                {
                    "type": "NumberSpinner",
                    "name": "PixooNightBrightness",
                    "caption": "Helligkeit Nacht (0–100)",
                    "digits": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "PixooNightHourFrom",
                    "caption": "Nacht ab Stunde (0–23)",
                    "digits": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "PixooNightHourTo",
                    "caption": "Nacht bis Stunde (0–23, exkl.)",
                    "digits": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Wetter und Uhrzeit",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Nur im Grafikmodus. Wetter: die OpenWeatherMap-Variable „Wetterbedingung-Symbol“ (Kürzel wie 01d oder 10n) zeigt ein kleines Icon auf der PV. Temperatur: ganze Grad links neben dem Icon. Datum und Uhrzeit: Serverzeit rechts oben. Sind beide an, steht das Datum in der ersten Zeile und die Uhrzeit darunter. Ohne Datum steht die Uhrzeit in der ersten Zeile. Die Uhrzeit ersetzt dort den SMARD-Zeitstempel."
                },
                {
                    "type": "CheckBox",
                    "name": "PixooShowWeather",
                    "caption": "Wetter-Icon links neben der PV anzeigen"
                },
                {
                    "type": "SelectVariable",
                    "name": "PixooWeatherVar",
                    "caption": "Variable: Wetterbedingung-Symbol (OpenWeatherMap)"
                },
                {
                    "type": "CheckBox",
                    "name": "PixooShowTemperature",
                    "caption": "Temperatur links neben dem Wetter-Icon anzeigen"
                },
                {
                    "type": "SelectVariable",
                    "name": "PixooTemperatureVar",
                    "caption": "Variable: Temperatur"
                },
                {
                    "type": "CheckBox",
                    "name": "PixooShowClock",
                    "caption": "Uhrzeit rechts oben anzeigen (Stunde:Minute)"
                },
                {
                    "type": "CheckBox",
                    "name": "PixooShowDate",
                    "caption": "Datum rechts oben anzeigen"
                },
                {
                    "type": "Select",
                    "name": "PixooDateFormat",
                    "caption": "Datumsformat",
                    "options": [
                        {
                            "caption": "01.01.2025",
                            "value": 0
                        },
                        {
                            "caption": "01.01.25",
                            "value": 1
                        },
                        {
                            "caption": "DO 01.01.25",
                            "value": 2
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "SMARD Strompreis",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Börsenpreis für den nächsten Tag, DE/LU (Filter 4169, Viertelstunden), www.smard.de, Abholung alle 15 Min. Wert EUR/MWh → Anzeige als Zahl in € (÷1000). Rechts in der Netz-Zeile: gleiche Schriftgröße wie die Netz-Watt-Zahl (Schrift 26, Zeilenhöhe 8). Positiver Wert = grün, sonst rot."
                },
                {
                    "type": "Label",
                    "caption": "Optionaler Zeitstempel: festes Format Stunde:Minute (24 h, z. B. 14:30), rechts in derselben Zeile wie die Beschriftung „NETZ“; gleiche Ziffern-Schrift wie die Watt-Werte (Schrift 26), kompakte Zeilenhöhe."
                },
                {
                    "type": "CheckBox",
                    "name": "PixooShowSmardPrice",
                    "caption": "SMARD-Preis auf Pixoo anzeigen"
                },
                {
                    "type": "CheckBox",
                    "name": "PixooSmardShowUnit",
                    "caption": "Preis mit „€“ anhängen"
                },
                {
                    "type": "CheckBox",
                    "name": "PixooSmardShowTime",
                    "caption": "Zeitstempel der SMARD-Daten neben „NETZ“ (rechts)"
                },
                {
                    "type": "Label",
                    "caption": "Hinweis: Es wird der Beginn der Viertelstunde der zuletzt vom Modul geladenen SMARD-Daten angezeigt (Format Stunde:Minute) — nicht die laufende Uhrzeit."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Home Manager 2 (Wirkleistung ±)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Wirkleistung + (Real Power +) = Netzbezug, Wirkleistung − (Real Power −) = Netzeinspeisung (W). Text- oder Zahlenvariablen. Netz = Bezug − Einspeisung."
                },
                {
                    "type": "SelectVariable",
                    "name": "HmRealPowerPlusVar",
                    "caption": "Variable: Wirkleistung + (Real Power +, Netzbezug, W)"
                },
                {
                    "type": "SelectVariable",
                    "name": "HmRealPowerMinusVar",
                    "caption": "Variable: Wirkleistung − (Real Power −, Netzeinspeisung, W)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Wechselrichter 1 (2 Variablen)",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Zwei Variablen pro WR (Text- oder Zahlenvariablen). Erzeugung = Summe aller vier Werte (je Wert ≥ 0). Bei Fehler 201: Meldungsarchiv, Eintrag „Konfiguration“."
                },
                {
                    "type": "SelectVariable",
                    "name": "Wr1String1Var",
                    "caption": "Variable 1 (Leistung W)"
                },
                {
                    "type": "SelectVariable",
                    "name": "Wr1String2Var",
                    "caption": "Variable 2 (Leistung W)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Wechselrichter 2 (2 Variablen)",
            "expanded": false,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "Wr2String1Var",
                    "caption": "Variable 1 (Leistung W)"
                },
                {
                    "type": "SelectVariable",
                    "name": "Wr2String2Var",
                    "caption": "Variable 2 (Leistung W)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Batterie",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Ladestand in Prozent. Laden und Entladen sind zwei Variablen, beide in Watt und immer positiv. Die größere Leistung steht rechts: Laden grün, Entladen rot. Ohne Variable zeigt das Pixoo „--“."
                },
                {
                    "type": "SelectVariable",
                    "name": "BatterySocVar",
                    "caption": "Variable: Ladestand (%)"
                },
                {
                    "type": "SelectVariable",
                    "name": "BatteryChargeVar",
                    "caption": "Variable: Ladeleistung (W, positiv)"
                },
                {
                    "type": "SelectVariable",
                    "name": "BatteryDischargeVar",
                    "caption": "Variable: Entladeleistung (W, positiv)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Wichtig nach Modul-Update: alle elf Quellvariablen setzen → Übernehmen → Button „Quellvariablen dauerhaft speichern“ (meldet elf IDs > 0). Erst dann IPS-Neustart testen."
        },
        {
            "type": "Button",
            "caption": "Quellvariablen dauerhaft speichern",
            "onClick": "echo SMAPX_PersistSourceVariableIdsFeedback($id);"
        },
        {
            "type": "Button",
            "caption": "SMARD-Preis laden",
            "onClick": "echo SMAPX_SmardLoadActionFeedback($id);"
        },
        {
            "type": "Button",
            "caption": "Jetzt aktualisieren (Werte + Pixoo)",
            "onClick": "SMAPX_Refresh($id); echo 'Aktualisiert.';"
        },
        {
            "type": "Button",
            "caption": "Display neu initialisieren",
            "onClick": "echo SMAPX_HeavyReinitDisplayFeedback($id);"
        },
        {
            "type": "Label",
            "caption": "Grafikmodus: Energiefluss mit PV oben, Netz links, Batterie rechts und Haus unten. Die Batterie füllt sich mit dem Ladestand: unter 25 % rot, bis 75 % gelb, darüber grün. Die Variable „Flussanimation“ schaltet die laufende Richtung an oder zeigt ein Standbild mit Pfeilen. Umschalten über den Schalter oben oder die Variable „Grafikmodus (Energiefluss)“."
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Inaktiv"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Konfiguration ungültig (alle sechs Variablen prüfen)"
        }
    ]
}
