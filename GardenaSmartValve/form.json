{
    "elements": [
        {
            "type": "Label",
            "name": "ModuleVersionInfo",
            "caption": "Installierte Modulversion"
        },
        {
            "type": "SelectInstance",
            "name": "GatewayInstanceID",
            "caption": "Gateway-Instanz",
            "validModules": [
                "{8F3A2C1D-9E4B-4A7C-B2D1-6E5F4A3B2C1D}"
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceId",
            "caption": "Geräte-ID"
        },
        {
            "type": "ValidationTextBox",
            "name": "ModelNumber",
            "caption": "Modellnummer"
        },
        {
            "type": "NumberSpinner",
            "name": "Generation",
            "caption": "Generation (1/2)",
            "digits": 0,
            "minimum": 1,
            "maximum": 2
        },
        {
            "type": "NumberSpinner",
            "name": "ValveCount",
            "caption": "Anzahl Ventile",
            "digits": 0,
            "minimum": 1,
            "maximum": 6
        },
        {
            "type": "Label",
            "name": "UsageHint",
            "caption": "Wasserverbrauch: Preset am Gateway anlegen, hier je Ausgang wählen und speichern — sonst wird der Verbrauch nicht gezählt (auch bei Zeitplan aus der App)."
        },
        {
            "type": "Select",
            "name": "OutletAPreset",
            "caption": "Ausgang A: Durchfluss-Preset",
            "options": [
                { "caption": "— Kein Verbrauch —", "value": "" }
            ]
        },
        {
            "type": "Select",
            "name": "OutletBPreset",
            "caption": "Ausgang B: Durchfluss-Preset",
            "options": [
                { "caption": "— Kein Verbrauch —", "value": "" }
            ]
        },
        {
            "type": "Label",
            "name": "ScheduleHint",
            "caption": "Geräte-Zeitpläne: IPS zeigt den Stand vom Gerät (Variable „Geräte-Zeitpläne“ / Zeitplan-Kachel). Bearbeitung nur in der Gardena-App."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Verbrauchszähler zurücksetzen",
            "onClick": "echo GSVAL_ResetWaterUsage($id);"
        },
        {
            "type": "Button",
            "caption": "Ventil A starten",
            "onClick": "GSVAL_StartValve($id, 0, 0); echo 'OK';"
        },
        {
            "type": "Button",
            "caption": "Ventil A stoppen",
            "onClick": "GSVAL_StopValve($id, 0); echo 'OK';"
        },
        {
            "type": "Button",
            "caption": "Ventil B starten",
            "onClick": "GSVAL_StartValve($id, 1, 0); echo 'OK';"
        },
        {
            "type": "Button",
            "caption": "Ventil B stoppen",
            "onClick": "GSVAL_StopValve($id, 1); echo 'OK';"
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Kein Gateway" }
    ]
}
