{
    "elements": [
        {
            "type": "Label",
            "name": "ModuleVersionInfo",
            "caption": "Installierte Modulversion"
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "ValidationTextBox",
            "name": "Host",
            "caption": "Gateway Host (IP oder Hostname)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Passwort (erste 8 Zeichen der Geräte-ID)"
        },
        {
            "type": "NumberSpinner",
            "name": "Port",
            "caption": "WebSocket-Port",
            "digits": 0,
            "minimum": 1,
            "maximum": 65535
        },
        {
            "type": "CheckBox",
            "name": "TlsInsecure",
            "caption": "TLS-Zertifikat ignorieren (Self-Signed)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateIntervalSeconds",
            "caption": "Aktualisierungsintervall (Sekunden, mindestens 30)",
            "digits": 0,
            "minimum": 30
        },
        {
            "type": "Label",
            "name": "FlowPresetHint",
            "caption": "Durchfluss-Presets (zentral): werden in den Valve-Modulen zur Auswahl angeboten. Basis-Presets (Perl-Regner etc.) sind fest eingebaut."
        },
        {
            "type": "List",
            "name": "FlowPresets",
            "caption": "Eigene Durchfluss-Presets",
            "rowCount": 5,
            "add": true,
            "delete": true,
            "columns": [
                { "caption": "Bezeichnung", "name": "label", "width": "160px", "edit": { "type": "ValidationTextBox" }, "add": "Mein Regner", "save": true },
                { "caption": "Länge/Hinweis", "name": "length", "width": "100px", "edit": { "type": "ValidationTextBox" }, "add": "20 m", "save": true },
                { "caption": "Druck", "name": "pressure", "width": "80px", "edit": { "type": "ValidationTextBox" }, "add": "2 bar", "save": true },
                { "caption": "l/h", "name": "litersPerHour", "width": "80px", "edit": { "type": "NumberSpinner", "digits": 1, "minimum": 0 }, "add": 300, "save": true }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Verbindung testen",
            "onClick": "echo GSGW_TestConnection($id);"
        },
        {
            "type": "Button",
            "caption": "Geräte scannen / anlegen",
            "onClick": "echo GSGW_ScanAndCreateDevices($id);"
        },
        {
            "type": "Button",
            "caption": "Jetzt aktualisieren",
            "onClick": "GSGW_UpdateValues($id); echo 'OK';"
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Verbunden" },
        { "code": 104, "icon": "inactive", "caption": "Inaktiv" },
        { "code": 201, "icon": "error", "caption": "Konfiguration ungültig" },
        { "code": 202, "icon": "error", "caption": "Gateway nicht erreichbar" }
    ]
}
