{
    "elements": [
        {
            "type": "Label",
            "name": "ModuleVersionInfo",
            "caption": "Installierte Modulversion"
        },
        {
            "type": "SelectInstance",
            "name": "GatewayInstanceID",
            "caption": "Gateway-Instanz",
            "validModules": [
                "{8F3A2C1D-9E4B-4A7C-B2D1-6E5F4A3B2C1D}"
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceId",
            "caption": "Geräte-ID"
        },
        {
            "type": "ValidationTextBox",
            "name": "ModelNumber",
            "caption": "Modellnummer"
        },
        {
            "type": "NumberSpinner",
            "name": "Generation",
            "caption": "Generation",
            "digits": 0,
            "minimum": 1,
            "maximum": 2
        },
        {
            "type": "NumberSpinner",
            "name": "DefaultDurationSec",
            "caption": "Einschaltdauer (Sekunden, 0 = 24h)",
            "digits": 0,
            "minimum": 0
        },
        {
            "type": "CheckBox",
            "name": "ScheduleEnabled",
            "caption": "IPS-Zeitpläne aktiv"
        },
        {
            "type": "List",
            "name": "ScheduleRules",
            "caption": "IPS-Schalt-Zeitpläne",
            "rowCount": 4,
            "add": true,
            "delete": true,
            "columns": [
                { "caption": "Aktiv", "name": "active", "width": "50px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Start", "name": "start", "width": "70px", "edit": { "type": "ValidationTextBox" }, "add": "18:00", "save": true },
                { "caption": "Ende", "name": "end", "width": "70px", "edit": { "type": "ValidationTextBox" }, "add": "23:00", "save": true },
                { "caption": "Mo", "name": "mo", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Di", "name": "tu", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Mi", "name": "we", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Do", "name": "th", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Fr", "name": "fr", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "Sa", "name": "sa", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true },
                { "caption": "So", "name": "so", "width": "40px", "edit": { "type": "CheckBox" }, "add": true, "save": true }
            ]
        }
    ],
    "actions": [
        { "type": "Button", "caption": "Einschalten", "onClick": "GSPWR_SetPower($id, true); echo 'OK';" },
        { "type": "Button", "caption": "Ausschalten", "onClick": "GSPWR_SetPower($id, false); echo 'OK';" }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Kein Gateway" }
    ]
}
