{
    "elements": [
        {
            "type": "Label",
            "name": "ModuleVersionInfo",
            "caption": "Installierte Modulversion"
        },
        {
            "type": "SelectInstance",
            "name": "GatewayInstanceID",
            "caption": "Gateway-Instanz",
            "validModules": [
                "{8F3A2C1D-9E4B-4A7C-B2D1-6E5F4A3B2C1D}"
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceId",
            "caption": "Geräte-ID"
        },
        {
            "type": "ValidationTextBox",
            "name": "ModelNumber",
            "caption": "Modellnummer"
        },
        {
            "type": "NumberSpinner",
            "name": "Generation",
            "caption": "Generation",
            "digits": 0,
            "minimum": 1,
            "maximum": 2
        },
        {
            "type": "NumberSpinner",
            "name": "DefaultDurationSec",
            "caption": "Einschaltdauer (Sekunden, 0 = 24h)",
            "digits": 0,
            "minimum": 0
        },
        {
            "type": "Label",
            "name": "ScheduleHint",
            "caption": "Geräte-Zeitpläne (Gen1): Master am Gateway/Cloud. Bearbeitung nur in der Gardena-App — IPS zeigt den Stand read-only. Löschen optional über Button."
        }
    ],
    "actions": [
        { "type": "Button", "caption": "Einschalten", "onClick": "GSPWR_SetPower($id, true); echo 'OK';" },
        { "type": "Button", "caption": "Ausschalten", "onClick": "GSPWR_SetPower($id, false); echo 'OK';" },
        {
            "type": "Button",
            "caption": "Sonnen-Zeitplan löschen",
            "onClick": "echo GSPWR_ClearDeviceSchedules($id);"
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Kein Gateway" }
    ]
}
