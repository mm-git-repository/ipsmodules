{
    "elements": [
        {
            "type": "Label",
            "caption": "Die Verwaltung bündelt alle globalen Einstellungen der Hausanzeige: die Verwaltungsseite im Browser und den Dienst, über den alle Anzeigen Ansichten, Werte und Programm abholen. Eine Instanz genügt."
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Aktiv"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Verwaltungsseite",
            "expanded": true,
            "items": [
                {
                    "type": "PasswordTextBox",
                    "name": "AdminPassword",
                    "caption": "Passwort für die Verwaltungsseite"
                },
                {
                    "type": "Label",
                    "name": "AdminUrlLabel",
                    "caption": "Adresse der Verwaltungsseite (Editor): nach Übernehmen sichtbar."
                },
                {
                    "type": "Label",
                    "name": "AdminUrlNote",
                    "caption": "Hinweis zur Adresse."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Dienst für die Anzeigen",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Der Dienst wird automatisch eingerichtet und läuft über die erste aktive Hausanzeige-Instanz. Die Anzeigen bekommen die Dienstadresse bei der Kopplung oder im Einrichtungs-WLAN."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "ServiceHost",
                    "caption": "Dienstadresse (leer = automatisch, z. B. 192.168.1.10)",
                    "validate": "^$|^[A-Za-z0-9.\\-]+$"
                },
                {
                    "type": "Label",
                    "name": "ServiceUrlLabel",
                    "caption": "Dienst: wird nach dem Übernehmen angezeigt."
                },
                {
                    "type": "Label",
                    "name": "ServiceUrlNote",
                    "caption": "Hinweis zum Dienst."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Verwaltungsadresse anzeigen",
            "onClick": "IPS_ApplyChanges($id); $urlId = @IPS_GetObjectIDByIdent('AdminUrl', $id); echo $urlId > 0 ? GetValue($urlId) : 'Passwort setzen und Instanz übernehmen.';"
        },
        {
            "type": "Button",
            "caption": "Dienst neu einrichten",
            "onClick": "IPS_ApplyChanges($id); $urlId = @IPS_GetObjectIDByIdent('ServiceUrl', $id); echo 'Dienst: ' . ($urlId > 0 ? GetValue($urlId) : 'nicht eingerichtet');"
        }
    ],
    "status": [
        {"code": 102, "icon": "active", "caption": "Verwaltung aktiv"},
        {"code": 104, "icon": "inactive", "caption": "Verwaltung inaktiv"},
        {"code": 201, "icon": "error", "caption": "Verwaltung konnte nicht gestartet werden"},
        {"code": 202, "icon": "error", "caption": "Passwort für die Verwaltungsseite fehlt"}
    ]
}
